# ==============================================================================
# Environment Configuration for Fantasy Football API
# ==============================================================================

ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PROJECT_NAME="Fantasy Football API"

# Allowed CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database (Transaction Pooler - Port 6543)
# ------------------------------------------------------------------------------
# In Vercel serverless functions, ALWAYS use the transaction pooler with prepared_statement_cache_size=0
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@[POOLER_HOST]:6543/postgres?prepared_statement_cache_size=0
DATABASE_URL=postgresql+asyncpg://postgres.yourprojectref:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?prepared_statement_cache_size=0
DB_ECHO=false

# ------------------------------------------------------------------------------
# Supabase Authentication & Project Keys
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase JWT Secret is found under Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
